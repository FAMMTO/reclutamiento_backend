# ── Servidor ────────────────────────────────────────────────────────────────
PORT=4000
APP_ENV=development                 # development | production

# Orígenes permitidos para el frontend (lista separada por comas, coincidencia exacta)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ── Base de datos ───────────────────────────────────────────────────────────
# Desarrollo local:
DATABASE_URL=postgres://localhost:5432/jobbly_dev?sslmode=disable
# Producción (Postgres en el VPS — sslmode=require es OBLIGATORIO):
# DATABASE_URL=postgres://jobbly:<password>@<ip-del-vps>:5432/jobbly?sslmode=require

# ── Autenticación ───────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h              # 7 días
COOKIE_SECURE=false                 # true en producción (HTTPS)
# COOKIE_DOMAIN=.jobbly.mx          # solo en producción

# ── Cifrado en reposo (AES-256-GCM para secretos de Meta/terceros) ──────────
# Debe ser EXACTAMENTE 32 caracteres ASCII.
# Generar con: openssl rand -hex 16   (o cualquier cadena de 32 chars)
ENCRYPTION_KEY=cambia-esto-32-chars-exactos!!

# ── Facebook OAuth (Meta for Developers) ────────────────────────────────────
# FACEBOOK_REDIRECT_URI debe estar registrada en tu App de Meta como "Valid OAuth Redirect URI"
# Dev: http://localhost:4000/api/v1/facebookads/oauth/callback
# Prod: https://api.tu-dominio.com/api/v1/facebookads/oauth/callback
FACEBOOK_REDIRECT_URI=http://localhost:4000/api/v1/facebookads/oauth/callback
# URL del frontend al que redirigir tras el callback (default: primer CORS_ORIGIN)
# FACEBOOK_FRONTEND_URL=http://localhost:8080

# ── Admin inicial (solo se crea si no existe ningún reclutador) ─────────────
SEED_ADMIN_NAME=Administrador Jobbly
SEED_ADMIN_EMAIL=admin@jobbly.mx
SEED_ADMIN_PASSWORD=CambiaEsto123
