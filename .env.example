# ── Servidor ────────────────────────────────────────────────────────────────
PORT=4000
APP_ENV=development                 # development | production

# Orígenes permitidos para el frontend (lista separada por comas, coincidencia exacta)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ── Base de datos ───────────────────────────────────────────────────────────
# Desarrollo local:
DATABASE_URL=postgres://localhost:5432/jobbly_dev?sslmode=disable
# Producción (Postgres en el VPS — sslmode=require es OBLIGATORIO):
# DATABASE_URL=postgres://jobbly:<password>@<ip-del-vps>:5432/jobbly?sslmode=require

# ── Autenticación ───────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h              # 7 días
COOKIE_SECURE=false                 # true en producción (HTTPS)
# COOKIE_DOMAIN=.jobbly.mx          # solo en producción

# ── Admin inicial (solo se crea si no existe ningún reclutador) ─────────────
SEED_ADMIN_NAME=Administrador Jobbly
SEED_ADMIN_EMAIL=admin@jobbly.mx
SEED_ADMIN_PASSWORD=CambiaEsto123
