# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://jobbly:<PASSWORD>@localhost:5432/jobbly_prod?sslmode=disable

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=4000
ENV=production

# ── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=<min-32-chars-random>
# Genera con: openssl rand -hex 32

# ── Cookies ──────────────────────────────────────────────────────────────────
COOKIE_SECURE=true
COOKIE_DOMAIN=jobbly.mx

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://jobbly.mx,https://www.jobbly.mx

# ── Encriptación (AES-256-GCM para secretos de Meta) ─────────────────────────
ENCRYPTION_KEY=<32-bytes-hex-encoded>
# Genera con: openssl rand -hex 32

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@jobbly.mx

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_BASE_URL=https://jobbly.mx

# ── Facebook Ads ──────────────────────────────────────────────────────────────
FACEBOOK_APP_ID=<your-app-id>
FACEBOOK_APP_SECRET=<your-app-secret>
FACEBOOK_REDIRECT_URI=https://api.jobbly.mx/api/v1/facebookads/oauth/callback
FACEBOOK_FRONTEND_URL=https://jobbly.mx

# ── Admin inicial (solo primer arranque; idempotente si ya existe un reclutador) ──
SEED_ADMIN_EMAIL=admin@jobbly.mx
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_PASSWORD=<temporal-segura>
